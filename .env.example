# FreshBooks app (create at https://my.freshbooks.com/#/developer)
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the app (FreshBooks requires https)
FRESHBOOKS_REDIRECT_URI=https://example.com/callback
# Optional: only needed if your login belongs to more than one business
FRESHBOOKS_BUSINESS_ID=

# Productive (Settings > API integrations)
PRODUCTIVE_API_TOKEN=
PRODUCTIVE_ORG_ID=

# Timezone used to decide which day an entry belongs to
SYNC_TIMEZONE=America/Chicago

# Append "[FreshBooks #id]" to Productive notes (helps audits/reconciliation)
TAG_NOTES=true

# File locations (defaults shown)
MAPPING_FILE=mapping.json
STATE_FILE=sync_state.json
FRESHBOOKS_TOKEN_FILE=freshbooks_tokens.json
